{
  "expo": {
    "name": "sentra",
    "slug": "sentra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon1.png",
    "scheme": "sentra",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon1.png",
        "backgroundColor": "#00027d",
        "dark": {
          "image": "./assets/icon1.png",
          "backgroundColor": "#00027d"
        },
        "imageWidth": 200
      },
      "edgeToEdgeEnabled": true,
      "package": "com.jasonsw.sentra",
      "permissions": ["INTERNET"],
      "usesCleartextTraffic": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon1.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "cover",
          "backgroundColor": "#00027d"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2830718d-fe50-46d5-bb2b-3e8840055df5"
      }
    }
  }
}
